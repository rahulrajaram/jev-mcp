{
  "name": "jev-mcp",
  "version": "0.5.0",
  "description": "MCP server exposing TypeSafe Jev typed judgments — classify, score, check, a batched multi-question ask, and model discovery — over the TypeSafe API or OpenRouter. Fork of rashedint32/jev-mcp 0.4.0 adding the OpenRouter path and corrected limits.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahulrajaram/jev-mcp.git"
  },
  "homepage": "https://github.com/rahulrajaram/jev-mcp#readme",
  "bugs": {
    "url": "https://github.com/rahulrajaram/jev-mcp/issues"
  },
  "bin": {
    "jev-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typesafe",
    "jev",
    "system-one",
    "openrouter",
    "classification",
    "confidence",
    "ai"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/e2e.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
